
map $http_upgrade $telemt_connection_upgrade {
    default upgrade;
    ''      '';
}

upstream telemt_web {
    server telemt:18080;
    keepalive 64;
}

server {
    listen 80;
    server_name "SERVER";

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl;
    http2 on;

    server_name "SERVER";

    access_log off;

    ssl_certificate
        /etc/letsencrypt/live/"SERVER"/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/"SERVER"/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 2m;

    # Web Proxy: основной маршрут
    location ^~ /telegram/web/ {
        proxy_pass http://telemt_web;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $telemt_connection_upgrade;

        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;
        proxy_read_timeout 65s;

        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;
    }

    # Не допускаем автоматический redirect со слешем
    location = /telegram/web {
        proxy_pass http://telemt_web;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Обычный сайт
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
    }
}
