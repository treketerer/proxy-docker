
[general]
use_middle_proxy = true

[general.modes]
classic = true
secure = false
tls = true

[general.links]
show = ["default"]

[access.users]
default = "TOKEN"

# Классический MTProxy через старый GOST-ретранслятор
[[server.listeners]]
ip = "0.0.0.0"
port = 9030
transport = "mtproxy"
proxy_protocol = false

# Web Proxy для NGINX
[[server.listeners]]
ip = "0.0.0.0"
port = 18080
transport = "web"
proxy_protocol = false
reuse_allow = false
web_client_ip_source = "x_forwarded_for"
web_trusted_proxy_cidrs = [INNER_IP/32"]

[web]
enabled = true
carrier = "https-lanes"
decoy_fasttrack_mode = "off"
http_connection_capacity_action = "drop"

[[web.vhosts]]
host = "SERVER"
base_path = "telegram/web"
public_addr = "SERVER_IP:443"

[web.vhosts.decoy]
mode = "static_directory"
directory = "/var/lib/telemt/public"
index = "index.html"

[[web.vhosts.profiles]]
user = "default"
secret_mode = "plain"
max_sessions = 8
max_streams = 512
max_streams_per_session = 64

[censorship]
tls_domain = "dns-shop.ru"
mask = true
tls_emulation = true
tls_front_dir = "/run/telemt/tlsfront"
